{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heuriva",
  "version": "1.0.0",
  "identifier": "dev.heuriva.session",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:8766",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Heuriva",
        "width": 980,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/heuriva-sidecar"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": ""
    },
    "longDescription": "Heuriva local Session UI. Thin Tauri shell that starts a Python sidecar and opens the localhost Session page. Not a remote dashboard.",
    "shortDescription": "Heuriva local cognitive Session",
    "category": "DeveloperTool"
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
