# Heuriva local environment example
# Copy values into ~/.heuriva/.env, not into this repository.

HEURIVA_LLM_BASE_URL=http://localhost:8765/v1
HEURIVA_LLM_MODEL=auto
HEURIVA_API_KEY=
HEURIVA_DB_PATH=~/.heuriva/memory.db

# Optional live checks. Normal tests do not require local LLM or web search.
HEURIVA_RUN_LIVE_LLM_TESTS=0
HEURIVA_RUN_LIVE_SEARCH_TESTS=0
